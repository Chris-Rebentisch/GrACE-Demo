# =============================================================================
# GrACE-Demo — runtime configuration (.env)
# Copy to `.env` and fill in the two lines marked <…>. Never commit `.env`.
# =============================================================================

# --- Cloud LLM (the student's chosen vendor — GrACE calls this) --------------
# Anthropic, OpenAI, DeepSeek, Groq, Together, xAI, or any OpenAI-compatible
# chat API. Pick provider/model/base_url in config/discovery.yaml `llm:` block
# (docs/LLM_OPERATOR.md Session 0). The key lives ONLY here.
LLM_API_KEY=<your-cloud-llm-api-key>

# --- Embeddings (OPTIONAL) ---------------------------------------------------
# auto   = use OpenAI-compatible /v1/embeddings when GRACE_EMBED_API_KEY is set
#          (or the chat vendor above is real OpenAI); otherwise OFF. With a
#          chat-only key (Anthropic / DeepSeek / Groq ...) the demo runs without
#          vectors: keyword + graph retrieval, exact-name entity resolution.
# openai = force OpenAI-compatible embeddings (needs a key below)
# ollama = local nomic-embed-text (`ollama pull nomic-embed-text`)
# none   = force off
GRACE_EMBED_PROVIDER=auto
GRACE_EMBED_BASE_URL=https://api.openai.com/v1
GRACE_EMBED_MODEL=text-embedding-3-small
GRACE_EMBED_DIMENSIONS=768
GRACE_EMBED_API_KEY=

# --- Optional local Ollama (NOT required) -----------------------------------
# Only used if you choose provider: ollama in config/discovery.yaml or
# GRACE_EMBED_PROVIDER=ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_USE_MLX=false

# --- PostgreSQL --------------------------------------------------------------
# macOS/Linux: your OS user, usually no password.  Windows: postgres user +
# the password you set at install: postgresql+psycopg2://postgres:<pw>@localhost:5432/grace_demo
# Use the dedicated demo database. Tests auto-redirect to grace_demo_test.
DATABASE_URL=postgresql+psycopg2://<your-postgres-user>@localhost:5432/grace_demo

# --- ArcadeDB (graph database, Docker) --------------------------------------
ARCADE_HOST=localhost
ARCADE_PORT=2480
ARCADE_USERNAME=root
ARCADE_PASSWORD=gracedev
ARCADE_DATABASE=grace_demo
ARCADE_TIMEOUT=30
# JVM heap for the ArcadeDB container (docker/docker-compose.arcade.yml).
# Laptop default -Xms1G -Xmx3g; raise for large corpora, e.g. "-Xms4G -Xmx8g".
# ARCADE_HEAP=-Xms1G -Xmx3g

# --- API / server ------------------------------------------------------------
GRACE_HOST=localhost
GRACE_PORT=8000
METRICS_ENDPOINT_PATH=/metrics
GRACE_ADMIN_KEY=
GRACE_CORS_ORIGINS=
GRACE_PERMISSION_ENFORCEMENT_ENABLED=0

# --- MCP (optional: Claude Desktop / Claude Code tool server) ----------------
MCP_GRACE_BASE_URL=http://127.0.0.1:8000
MCP_TIMEOUT_SECONDS=30

# --- Document processing -----------------------------------------------------
# macOS OpenMP/Docling stability (harmless elsewhere).
KMP_DUPLICATE_LIB_OK=TRUE
OMP_NUM_THREADS=1
# Run offline after models are cached (bash scripts/prefetch-models.sh once).
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# --- Misc --------------------------------------------------------------------
GRAPH_HEALTH_EXPORTER_INTERVAL_SECONDS=60
GRAPH_HEALTH_EXPORTER_TOPN=20
ONTOLOGY_METRIC_TOPN=20
REGENERATION_TOTAL_INPUT_BUDGET_TOKENS=8000
NEXT_TELEMETRY_DISABLED=1
