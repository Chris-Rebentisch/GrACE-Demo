# =============================================================================
# GrACE-Demo — runtime configuration (.env)
# Copy to `.env` and fill in values. Never commit `.env`.
# =============================================================================

# --- Cloud LLM (default brain) ----------------------------------------------
# Any of: Anthropic, OpenAI, DeepSeek, Groq, Together, or another
# OpenAI-compatible API. Set provider/model in config/discovery.yaml or
# in Settings. The key is read from LLM_API_KEY.
LLM_API_KEY=<your-cloud-llm-api-key>

# --- Embeddings (default: cloud, 768-dim to match ArcadeDB) -----------------
# openai = OpenAI-compatible /v1/embeddings (no local GPU).
# ollama = local nomic-embed-text (optional; can lock a student laptop).
GRACE_EMBED_PROVIDER=openai
GRACE_EMBED_BASE_URL=https://api.openai.com/v1
GRACE_EMBED_MODEL=text-embedding-3-small
GRACE_EMBED_DIMENSIONS=768
# Optional separate key; defaults to LLM_API_KEY.
GRACE_EMBED_API_KEY=

# --- Optional local Ollama (not required for first run) ---------------------
# Only needed if GRACE_EMBED_PROVIDER=ollama or you pick a local chat model
# in Settings. Then: `ollama pull nomic-embed-text` (and a chat model).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_USE_MLX=false

# --- PostgreSQL --------------------------------------------------------------
# Use a dedicated database (grace_demo), never a production GOLD corpus.
DATABASE_URL=postgresql+psycopg2://<user>@localhost:5432/grace_demo

# --- ArcadeDB (graph database) ----------------------------------------------
ARCADE_HOST=localhost
ARCADE_PORT=2480
ARCADE_USERNAME=root
ARCADE_PASSWORD=gracedev
ARCADE_DATABASE=grace_demo
ARCADE_TIMEOUT=30

# --- API / server ------------------------------------------------------------
GRACE_HOST=localhost
GRACE_PORT=8000
METRICS_ENDPOINT_PATH=/metrics
GRACE_ADMIN_KEY=
GRACE_CORS_ORIGINS=
GRACE_PERMISSION_ENFORCEMENT_ENABLED=0

# --- MCP ---------------------------------------------------------------------
MCP_GRACE_BASE_URL=http://127.0.0.1:8000
MCP_TIMEOUT_SECONDS=30

# --- Document processing (macOS OpenMP/Docling stability) -------------------
KMP_DUPLICATE_LIB_OK=TRUE
OMP_NUM_THREADS=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# --- Frontend ----------------------------------------------------------------
NEXT_PUBLIC_GRACE_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_GRACE_APP_VERSION=1.0.0
NEXT_TELEMETRY_DISABLED=1

# --- Misc --------------------------------------------------------------------
GRAPH_HEALTH_EXPORTER_INTERVAL_SECONDS=60
GRAPH_HEALTH_EXPORTER_TOPN=20
ONTOLOGY_METRIC_TOPN=20
REGENERATION_TOTAL_INPUT_BUDGET_TOKENS=8000
# Grafana stack is NOT part of the Demo default install.
GRAFANA_POSTGRES_PASSWORD=unused
